{
  "name": "task-management-api",
  "version": "1.0.0",
  "description": "Task management API built with Express, TypeScript, Prisma, and MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "test": "tsx --test src/modules/user/user.validation.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && node scripts/copy-prisma-client.mjs",
    "start": "node dist/server.js",
    "validate": "prisma validate"
  },
  "keywords": [
    "task-management",
    "express",
    "typescript",
    "prisma",
    "mongodb"
  ],
  "author": "",
