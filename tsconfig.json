{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "paths": {
      "config/*": ["./src/config/*"],
      "modules/*": ["./src/modules/*"],
      "utils/*": ["./src/utils/*"],
      "middleware/*": ["./src/middleware/*"],
      "interfaces/*": ["./src/interfaces/*"]
    }
  },
  "include": ["src/**/*"]
}